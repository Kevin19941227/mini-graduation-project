# =========================================================
# Unity project stored in subfolder: graduation/
# Suitable for Unity 3D, URP, HDRP, SRP team collaboration
# =========================================================

# =========================
# Unity generated folders
# =========================
/graduation/[Ll]ibrary/
/graduation/[Tt]emp/
/graduation/[Oo]bj/
/graduation/[Bb]uild/
/graduation/[Bb]uilds/
/graduation/[Ll]ogs/
/graduation/[Uu]ser[Ss]ettings/
/graduation/[Mm]emoryCaptures/
/graduation/[Rr]ecordings/

# Burst / generated caches sometimes appear in project subfolders
/graduation/**/BurstDebugInformation_DoNotShip/
/graduation/**/NativeDataCache/
/graduation/**/Bee/

# =========================
# Addressables generated content
# =========================
/graduation/[Aa]ssets/[Ss]treamingAssets/aa*
/graduation/[Aa]ssets/[Ss]treamingAssets/com.unity.addressables*
/graduation/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# =========================
# IDE / Editor
# =========================
.vs/
.idea/
.vscode/
.consulo/
.gradle/
ExportedObj/
*.code-workspace

# Rider / JetBrains plugin autogenerated
/graduation/[Aa]ssets/Plugins/Editor/JetBrains*

# =========================
# Visual Studio / MonoDevelop / Rider generated
# =========================
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Generated meta files for debug/project files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# =========================
# Build outputs / packages
# =========================
*.apk
*.aab
*.ap_
*.ipa
*.app
*.unitypackage

# =========================
# Logs / crash / profiling
# =========================
*.log
*.stacktrace
*.dmp
sysinfo.txt

# Crashlytics
crashlytics-build.properties

# =========================
# OS generated files
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Test / coverage
# =========================
coverage/
TestResults/

# =========================
# Optional ignores
# Uncomment if needed
# =========================

# Ignore Asset Store tools plugin if you use it
# /graduation/[Aa]ssets/AssetStoreTools*

# Ignore generated Android assets if present
# /graduation/[Aa]ssets/[Ss]treamingAssets/aa.meta

# Ignore local save / debug dumps you may create manually
# *.bak
# *.old
# *.orig