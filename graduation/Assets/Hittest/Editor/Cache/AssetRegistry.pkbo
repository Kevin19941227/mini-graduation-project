{
	CustomName = "sim.selfId";
	ClassType = Math;
	Description = {
		"@eng:Returns the internal 64-bit particle ID.\\n\\n**Beware when using this !** The ID is not 0-based, its value is mostly undefined and the internal bit-layout can change without notice in a future SDK update.\\n\\nThis value will never be the same for any particle in the entire PopcornFX scene, unless the `x` component overflows a 32-bits integer and wraps around.",
	};
	Public = true;
	EmitDeprecationWarning = true;
